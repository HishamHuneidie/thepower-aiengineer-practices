# Copia este archivo a .env y rellena la clave. .env está en .gitignore.
# Clave de Gemini API (AI Studio), no credenciales de Google Cloud.
GEMINI_API_KEY=

# Modelos y agente (valores de referencia del enunciado)
MULTIMODAL_MODEL_ID=
TTS_MODEL_ID=
TTS_VOICE=
DEEP_RESEARCH_AGENT_ID=

# Límites de la investigación
RESEARCH_MAX_REAL_RUNS=1      # investigaciones reales permitidas; después se reutiliza la guardada
RESEARCH_MAX_POLLS=6          # consultas de estado por turno
RESEARCH_POLL_SECONDS=10      # espera entre consultas (6 x 10 s = 1 min máximo por turno)
AUDIO_MAX_SECONDS=30
